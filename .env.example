# Supabase project URL – safe to expose to the browser
# Found in: Supabase Dashboard → Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Public anonymous key – safe to expose to the browser
# Supabase renamed this "publishable key" in newer dashboard versions (same key, new label)
# Found in: Supabase Dashboard → Settings → API → Secret API keys → publishable (or "anon public")
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable-key>

# Service role key – server-side only, never reference in client code
# Supabase renamed this "secret key" in newer dashboard versions (same key, new label)
# Found in: Supabase Dashboard → Settings → API → Secret API keys → secret (or "service_role")
# ⚠ Put the real value only in .env.local – never commit it
SUPABASE_SERVICE_ROLE_KEY=<secret-key>

# Postgres connection via Transaction Pooler (PgBouncer) – port 6543
# Used by: migration script, Prisma client (runtime queries)
# Found in: Supabase Dashboard → Settings → Database → Connection string → Transaction mode
# ⚠ Put the real value (with password) only in .env.local – never commit it
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>.pooler.supabase.com:6543/postgres

# Direct Postgres connection (bypasses PgBouncer) – port 5432
# Used by: Prisma CLI for schema migrations only (prisma migrate deploy)
# Found in: Supabase Dashboard → Settings → Database → Connection string → Direct connection
# ⚠ Put the real value (with password) only in .env.local – never commit it
DIRECT_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
